{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/state",
      "destination": "/api/state"
    },
    {
      "source": "/api/nim/(.*)",
      "destination": "https://integrate.api.nvidia.com/v1/$1"
    },
    {
      "source": "/((?!api/|mcp|state).*)",
      "destination": "/index.html"
    }
  ]
}
