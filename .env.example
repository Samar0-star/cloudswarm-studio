# =============================================================================
# CloudSwarm Studio Environment Configuration (Optional)
# =============================================================================
# CloudSwarm Studio runs 100% out of the box with zero external API keys needed!
# A built-in deterministic simulation engine executes multi-agent synthesis,
# rate-card pricing, CIS security audits, and time-travel commits locally.
#
# To enable live streaming LLM generation, rename this file to `.env.local`
# and provide your API keys below:
# =============================================================================

# Google Gemini API Key (Optional — for live Gemini 2.0 Flash / Pro synthesis)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Groq API Key (Optional — for ultra-fast Llama-3.3-70b synthesis)
# Get a key at: https://console.groq.com/
VITE_GROQ_API_KEY=

# Local WebMCP Bridge Port (Default: 3001)
VITE_BRIDGE_PORT=3001
